{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/content/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|value|key|ref|className|style|children)$/]",
        "message": "<DlBadge> doesn't accept that prop. Declared props: size, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<DlBadge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlBottomNavigationTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|icon|badge|key|ref|className|style|children)$/]",
        "message": "<DlBottomNavigationTab> doesn't accept that prop. Declared props: text, icon, badge."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|type|size|state|iconLeft|iconRight|fullWidth|key|ref|className|style|children)$/]",
        "message": "<DlButton> doesn't accept that prop. Declared props: label, onClick, type, size, state, iconLeft, iconRight, fullWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlButton'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:primary|secondary|tertiary|ghost)$/]",
        "message": "<DlButton> type must be one of 'primary' | 'secondary' | 'tertiary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm|xs)$/]",
        "message": "<DlButton> size must be one of 'lg' | 'md' | 'sm' | 'xs'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlButton'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|pressed|disabled)$/]",
        "message": "<DlButton> state must be one of 'default' | 'pressed' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlButtonDockButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|type|size|state|key|ref|className|style|children)$/]",
        "message": "<DlButtonDockButton> doesn't accept that prop. Declared props: label, onClick, type, size, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlButtonDockButton'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:primary|secondary|tertiary|ghost)$/]",
        "message": "<DlButtonDockButton> type must be one of 'primary' | 'secondary' | 'tertiary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlButtonDockButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm|xs)$/]",
        "message": "<DlButtonDockButton> size must be one of 'lg' | 'md' | 'sm' | 'xs'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlButtonDockButton'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|pressed|disabled)$/]",
        "message": "<DlButtonDockButton> state must be one of 'default' | 'pressed' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlButtonIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|onClick|type|size|state|key|ref|className|style|children)$/]",
        "message": "<DlButtonIcon> doesn't accept that prop. Declared props: icon, onClick, type, size, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlButtonIcon'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:primary|secondary|tertiary|ghost)$/]",
        "message": "<DlButtonIcon> type must be one of 'primary' | 'secondary' | 'tertiary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlButtonIcon'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm|xs)$/]",
        "message": "<DlButtonIcon> size must be one of 'lg' | 'md' | 'sm' | 'xs'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlButtonIcon'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|pressed|disabled)$/]",
        "message": "<DlButtonIcon> state must be one of 'default' | 'pressed' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|enableActiveState|state|size|key|ref|className|style|children)$/]",
        "message": "<DlCard> doesn't accept that prop. Declared props: icon, title, description, enableActiveState, state, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|disabled)$/]",
        "message": "<DlCard> state must be one of 'default' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlCard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<DlCard> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|iconLeft|iconRight|value|onChange|type|size|enabled|errorHelperText|key|ref|className|style|children)$/]",
        "message": "<DlInput> doesn't accept that prop. Declared props: placeholder, iconLeft, iconRight, value, onChange, type, size, enabled, errorHelperText."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlInput'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:default|error|success)$/]",
        "message": "<DlInput> type must be one of 'default' | 'error' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlInput'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|mg|sm)$/]",
        "message": "<DlInput> size must be one of 'lg' | 'mg' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlSeparator'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|key|ref|className|style|children)$/]",
        "message": "<DlSeparator> doesn't accept that prop. Declared props: orientation."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlSeparator'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<DlSeparator> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlTopNavigation'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|showSeparator|size|iconLeft|iconRight|onIconLeftClick|onIconRightClick|key|ref|className|style|children)$/]",
        "message": "<DlTopNavigation> doesn't accept that prop. Declared props: title, showSeparator, size, iconLeft, iconRight, onIconLeftClick, onIconRightClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='DlTopNavigation'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<DlTopNavigation> size must be one of 'md' | 'lg'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
